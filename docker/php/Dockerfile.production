# Estágio 1: Compilar assets (Node.js)
FROM node:6 as assets

WORKDIR /app

# Copiar arquivos de dependências
COPY package.json package-lock.json bower.json .bowerrc ./

# Instalar dependências globais e do projeto
RUN npm install -g bower gulp@3 \
    && npm install \
    && bower install --allow-root

# Copiar código fonte e gulpfile
COPY resources ./resources
COPY gulpfile.js ./
COPY vendor ./vendor
# Copiar public (exceto build/ que contém arquivos versionados antigos)
COPY public ./public
RUN rm -rf ./public/build

# Compilar assets (sem --production para evitar erro com arquivos já minificados)
RUN gulp

# Estágio 2: Imagem PHP final
FROM php:7.2-fpm

# Corrigir repositórios antigos
RUN sed -i 's/deb.debian.org/archive.debian.org/g' /etc/apt/sources.list \
    && sed -i 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    libzip-dev \
    default-mysql-client

# Limpar cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Instalar extensões PHP
RUN docker-php-ext-install \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip

# Instalar Composer
COPY --from=composer:1.10 /usr/bin/composer /usr/bin/composer

# Definir diretório de trabalho
WORKDIR /var/www

# Copiar arquivos da aplicação (exceto public, que será copiado do estágio de build)
COPY --chown=www-data:www-data . /var/www

# Copiar TODA a pasta public com assets compilados do estágio anterior
# Isso garante que todos os arquivos estáticos E assets compilados estejam presentes
COPY --from=assets --chown=www-data:www-data /app/public ./public

# Instalar dependências PHP (somente produção)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Definir permissões para diretórios que precisam de escrita
RUN chmod -R 775 /var/www/storage \
    && chmod -R 775 /var/www/bootstrap/cache

# Expor porta 9000
EXPOSE 9000

CMD ["php-fpm"]
