APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:SomeRandomStringGeneratedByArtisan
APP_URL=https://seu-dominio.com.br

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=seara
DB_USERNAME=laravel
DB_PASSWORD=sua-senha-segura-aqui
DB_ROOT_PASSWORD=sua-senha-root-segura-aqui

# Cache & Session (use redis em produção se disponível)
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Redis (opcional, descomente se usar)
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.seu-servidor.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@dominio.com
MAIL_PASSWORD=sua-senha-email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@seu-dominio.com.br
MAIL_FROM_NAME="Sistema Seara"

# Log Configuration
LOG_CHANNEL=stack
LOG_LEVEL=error

# Security
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
